{
  "name": "yuzhane-training",
  "version": "2.0.0",
  "description": "Telegram WebApp для обучения сотрудников + кабинет менеджера (GitHub Pages + Cloudflare Workers)",
  "private": true,
  "scripts": {
    "db:init:local": "wrangler d1 execute yuzhane --local --file=worker/schema.sql",
    "db:init": "wrangler d1 execute yuzhane --remote --file=worker/schema.sql",
    "dev": "wrangler dev",
    "web": "npx --yes serve docs -l 5500",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
